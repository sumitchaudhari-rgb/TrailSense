<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — NestedScrollView for full-page scroll.
  Chat section uses a fixed-height box; inner Column+verticalScroll cooperates
  correctly with NestedScrollView (unlike LazyColumn which breaks interop).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Header Cards (Status + Lat/Lon + Nearest + 2x2 grid) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeHeaderCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />

        <!-- 2. Map View — fixed 240dp with location FAB -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="6dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:contentDescription="Center Location"
                app:backgroundTint="#FFFFFF"
                app:srcCompat="@android:drawable/ic_menu_mylocation"
                app:tint="#388E3C"
                app:maxImageSize="20dp" />

        </FrameLayout>

        <!-- 3. Chat / AI Guide — wrap_content; inner scroll is a Column+verticalScroll
             which cooperates with NestedScrollView via nested scroll protocol -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeChatSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />

        <Space android:layout_width="match_parent" android:layout_height="12dp" />

        <!-- HIDDEN DATA WIRES — visibility="gone", used by Java logic only -->
        <TextView android:id="@+id/tvGpsStatus"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvLatitude"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvLongitude"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvNearestWaypoint"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvNearestWater"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvNearestShelter"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvNearestExit"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvChatOutput"       android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <EditText android:id="@+id/etChatInput"        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSendChat"        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMicChat"         android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCreateRoute"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClearRoute"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSafePointsQuick" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.chip.Chip android:id="@+id/chipShelter" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.chip.Chip android:id="@+id/chipWater"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.chip.Chip android:id="@+id/chipExit"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/cardSafePointsModal"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseSafePoints"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalShelterTitle"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalShelterDesc"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRouteShelter"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalWaterTitle"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalWaterDesc"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRouteWater"    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalExitTitle"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tvModalExitDesc"      android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRouteExit"     android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
